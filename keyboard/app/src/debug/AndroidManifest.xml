<?xml version="1.0" encoding="utf-8"?>
<!-- Humming (added): debug-only screens and hooks used by the CI screenshot run. Not in release builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.humming.keyboard.debug.TestFieldActivity"
            android:exported="true"
            android:label="Humming test field"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />
        <receiver
            android:name="com.humming.keyboard.debug.DebugVoiceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.humming.keyboard.debug.VOICE_PREVIEW" />
                <action android:name="com.humming.keyboard.debug.VOICE_CLOSE" />
                <action android:name="com.humming.keyboard.debug.VOICE_TEST" />
                <action android:name="com.humming.keyboard.debug.VOICE_DONE" />
                <action android:name="com.humming.keyboard.debug.MODEL_DOWNLOAD" />
                <action android:name="com.humming.keyboard.debug.CLIP_SEED" />
                <action android:name="com.humming.keyboard.debug.UI_MODE" />
                <action android:name="com.humming.keyboard.debug.VOICE_MENU" />
                <action android:name="com.humming.keyboard.debug.HANDOFF_GBOARD" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
