root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true

[{*.har,*.json,*yml,*.sh}]
indent_size = 2

[*.kt]
ij_kotlin_name_count_to_use_star_import = 99
ij_kotlin_name_count_to_use_star_import_for_members = 99

[*.{kt,kts}]
# Humming 1.7.1: ktlint (keyboard/ci/static_checks.sh) checks the Kotlin coding conventions (kotlin.code.style=official).
ktlint_code_style = intellij_idea
